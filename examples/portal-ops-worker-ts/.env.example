# Required for live mode. Create one at https://console.getsolari.com
SOLARI_API_KEY=slr_live_...

# Safe defaults use the synthetic portal created in a Solari sandbox. For an
# authorized external HTTPS portal, set PORTAL_URL and ALLOW_EXTERNAL_PORTAL=1.
DRY_RUN=0
# PORTAL_URL=https://portal.example.test/records
# ALLOW_EXTERNAL_PORTAL=0
PORTAL_USERNAME=demo-user
PORTAL_PASSWORD=demo-password
# Override these four selectors for the authorized external portal adapter.
# PORTAL_USERNAME_SELECTOR=input[name=username]
# PORTAL_PASSWORD_SELECTOR=input[name=password]
# PORTAL_LOGIN_SUBMIT_SELECTOR=button[type=submit]
# PORTAL_DOWNLOAD_SELECTOR=#download
PROFILE_NAME=portal-ops-demo
VOLUME_NAME=portal-ops-demo
TIMEOUT_MS=300000

# Optional live features. Keep disabled for the fixture to avoid proxy spend.
ENABLE_STEALTH=0
PROXY_COUNTRY=us
# PROXY_TIER=residential
# PROXY_SESSION=warm-1
# PROXY_SESSION_DURATION=10
CAPTCHA=0
RECORDING=0
ENABLE_DESKTOP=0
CLEANUP_VOLUME=0
# Test-only live failure injection after the CSV reaches the processing sandbox.
FAIL_AFTER_DOWNLOAD=0
